# Kopiraj u supabase/functions/.env (lokalno) ili postavi kao Supabase secrets (produkcija).
# Primalac i broj računa za ručnu uplatu su u tabeli app_settings (ključ manual_payment), ne ovde.
RATE_LIMIT_SCALE=1

# Obaveštenja (Faza 5). Lokalno: NOTIFY_DRY_RUN=true ne šalje ništa, samo beleži poruku kao poslatu.
NOTIFY_DRY_RUN=false
APP_URL=https://app.ttz.rs
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_LANG=sr
RESEND_API_KEY=
EMAIL_FROM=TTZ <tim@ttz.rs>
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tim@example.rs

# AI asistent (Faza 6). Bilo koji OpenAI-kompatibilan API: Qwen (Alibaba Model Studio), Mistral, OpenAI, Gemini…
# Lokalno: AI_DRY_RUN=true ne zove model, vraća predvidive lažne odgovore (testovi).
AI_DRY_RUN=false
AI_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
AI_API_KEY=
AI_MODEL=qwen-plus
AI_DAILY_LIMIT=30
